pipeline {
    agent any

    stages {
        stage('Checkout code') {
            steps {
                checkout scmGit(branches: [[name: '*/feature/OnPrem-k8s-dep']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/dockrphage/Word-counter.git']])
            }
        }
        stage('Building image') {
            steps {
                sh 'docker build -t word-counter .'
            }
        }
        stage('Pushing to Docker Hub') { 
            steps { sh 'echo $DOCKERHUB_PASSWORD | docker login -u $DOCKERHUB_USERNAME --password-stdin' 
                    sh 'docker tag word-counter:latest villedevops/word-counter:latest' 
                    sh 'docker push villedevops/word-counter:latest' } 
                    }
    }
}